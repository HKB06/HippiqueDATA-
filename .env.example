# Copie ce fichier en « .env » puis renseigne ta clé turf.bzh.
# La clé n'est affichée qu'une seule fois sur turf.bzh -> Mon compte -> Ma clé API.

# Clé API turf.bzh (format tbz_live_xxxxxxxx)
TURFBZH_API_KEY=tbz_live_REMPLACE_MOI

# Optionnel : activer la 2e source PMU (conditions: depart, corde, piste, penetrometre)
PMU_ENABLED=true

# Optionnel : activer la 2e source LeTrot (reduction km course par course)
LETROT_ENABLED=true

# Optionnel : repertoire de cache des reponses API (accelere les relances)
HIPPIQUE_CACHE_DIR=.cache
